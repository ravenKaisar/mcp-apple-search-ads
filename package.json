{
  "name": "apple-search-ads-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server for the Apple Search Ads / Apple Ads APIs (Campaign Management API v5 and Apple Ads Platform API v1). GET endpoints only.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "apple-search-ads-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/api-coverage.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "npm run build && vitest run --project e2e",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "docs:coverage": "tsx scripts/generate-coverage-docs.ts",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --transport stdio",
    "start:http": "node dist/index.js --transport http",
    "dev:stdio": "tsx src/index.ts --transport stdio",
    "dev:http": "tsx src/index.ts --transport http",
    "docker:build": "docker build -t apple-search-ads-mcp .",
    "docker:test": "bash scripts/docker-smoke-test.sh",
    "docker:publish": "bash scripts/docker-publish.sh"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apple-search-ads",
    "apple-ads",
    "read-only"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
