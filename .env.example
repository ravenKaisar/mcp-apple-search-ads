# Copy to .env (never commit .env). Apple credentials live in the accounts JSON file, not here.

# Transport: stdio (default) or http. The CLI flag --transport overrides this.
MCP_TRANSPORT=http
HOST=0.0.0.0
PORT=8080

# Path to the accounts/credentials JSON file (mount it read-only in Docker).
ACCOUNTS_CONFIG=/app/config/accounts.json

LOG_LEVEL=info
# Per-request timeout in milliseconds.
REQUEST_TIMEOUT=30000

# Which Apple APIs to expose as tools: campaign-management-v5 (alias v5), platform-v1 (alias platform).
ENABLED_APIS=campaign-management-v5,platform-v1

# Retries for 429/5xx/transient network errors (GET only).
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=16000
MAX_RETRY_AFTER_SECONDS=60

# fetch_all safety limits.
PAGINATION_DEFAULT_MAX_PAGES=10
PAGINATION_MAX_PAGES=100
PAGINATION_DEFAULT_MAX_RECORDS=1000
PAGINATION_MAX_RECORDS=10000

# HTTP transport hardening. Strongly recommended whenever the port is reachable by others.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Optional Host-header allow-list (DNS-rebinding protection), comma separated.
MCP_ALLOWED_HOSTS=
HTTP_MAX_BODY_BYTES=1048576

# OAuth client-secret JWT lifetime (seconds, max 180 days) and early token refresh window.
CLIENT_SECRET_TTL_SECONDS=3600
TOKEN_REFRESH_SKEW_SECONDS=60

# Testing only: point the server at mock Apple endpoints.
# APPLE_ADS_V5_BASE_URL=https://api.searchads.apple.com/api/v5
# APPLE_ADS_PLATFORM_BASE_URL=https://api.ads.apple.com/v1
# APPLE_OAUTH_TOKEN_URL=https://appleid.apple.com/auth/oauth2/token
# ALLOW_INSECURE_ENDPOINTS=false
